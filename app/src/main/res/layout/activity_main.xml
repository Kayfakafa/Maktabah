<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F9F9F9">

    <!-- Judul Aplikasi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Maktabah - Perpustakaan Kitab"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Tombol Pilih Folder -->
    <Button
        android:id="@+id/btnSelectFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Folder Kitab PDF"
        android:backgroundTint="#0D9488"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- Kotak Pencarian -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cari judul kitab..."
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <!-- Status Informasi -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada folder yang dipilih."
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:layout_marginBottom="8dp"/>

    <!-- Daftar Kitab -->
    <ListView
        android:id="@+id/listViewPdf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"/>

</LinearLayout>
